{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team workflow traceability linkage",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "use_cases", "screens", "scenarios", "test_cases"],
  "properties": {
    "requirements": {"$ref": "#/$defs/records"},
    "use_cases": {"$ref": "#/$defs/records"},
    "screens": {"$ref": "#/$defs/records"},
    "scenarios": {"$ref": "#/$defs/records"},
    "test_cases": {"$ref": "#/$defs/records"}
  },
  "$defs": {
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "references"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$"},
          "references": {
            "type": "array",
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$"}
          }
        }
      }
    }
  }
}
